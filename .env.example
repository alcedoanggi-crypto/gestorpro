# Copia este archivo a .env y ajusta los valores
FLASK_APP=wsgi.py
FLASK_CONFIG=development
SECRET_KEY=cambia-esta-clave-por-una-aleatoria-larga

# PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/gestorpro
TEST_DATABASE_URL=sqlite:///:memory:

# Reglas de negocio
TASK_DUE_SOON_DAYS=3

# Correo (recuperacion de contrasena / notificaciones)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=GestorPro <no-reply@gestorpro.local>
